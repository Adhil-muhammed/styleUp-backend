# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# PostgreSQL (Supabase — primary)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.icmshcvapojlqvgpkyat.supabase.co:5432/postgres
POSTGRES_HOST=db.icmshcvapojlqvgpkyat.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres
POSTGRES_SSL=true
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MIN=2
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000

# MongoDB (optional — not connected yet)
# MONGODB_URI=mongodb://localhost:27017/styleup
MONGO_PORT=27017
MONGO_DB=styleup

# Redis (required for OTP auth)
# Prefer REDIS_URL (Upstash uses rediss:// for TLS). When set, HOST/PORT/PASSWORD are ignored.
REDIS_URL=rediss://default:[YOUR-UPSTASH-TOKEN]@your-instance.upstash.io:6379
# Fallback for local Redis without TLS:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Gmail OTP email (App Password auth)
SMTP_USER=bookmycut26@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=StyleUp <bookmycut26@gmail.com>

# JWT — access 15m / refresh 7d (prefer dedicated secrets)
JWT_ACCESS_SECRET=your-jwt-access-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
# Legacy fallback (used if JWT_ACCESS_SECRET / JWT_REFRESH_SECRET unset)
# JWT_SECRET=your-jwt-secret-here

# OTP tuning
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RATE_MAX=3
AUTH_OTP_RATE_WINDOW_SECONDS=60
AUTH_OTP_MAX_VERIFY_ATTEMPTS=5
AUTH_OTP_IP_RATE_MAX=20
AUTH_OTP_IP_RATE_WINDOW_SECONDS=3600
AUTH_OTP_SMS_IP_RATE_MAX=10
AUTH_OTP_SMS_IP_RATE_WINDOW_SECONDS=3600
AUTH_OTP_DEVICE_RATE_MAX=20
AUTH_OTP_DEVICE_RATE_WINDOW_SECONDS=3600
# Test-only deterministic OTP (NODE_ENV=test only)
# AUTH_OTP_TEST_CODE=123456

# Session cleanup (revoked / expired user_sessions purge)
AUTH_SESSION_RETENTION_DAYS=7
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
AUTH_SESSION_CLEANUP_ENABLED=true

# Razorpay — payment gateway (UPI Intent + webhooks)
# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD SETUP (https://dashboard.razorpay.com — switch to TEST MODE):
#
# 1. API Keys
#    Settings → API Keys → Generate test key
#    → RAZORPAY_KEY_ID     = Key Id     (starts with rzp_test_)
#    → RAZORPAY_KEY_SECRET = Key Secret (shown once — save it)
#
# 2. Webhook (required to confirm booking after customer pays)
#    Account & Settings → Webhooks → + Add New Webhook
#    URL: https://<public-host>/api/webhooks/razorpay
#         Local dev: run `ngrok http 3000` → use https://xxxx.ngrok-free.app/api/webhooks/razorpay
#    Active events: payment.captured, payment.failed
#    → RAZORPAY_WEBHOOK_SECRET = secret shown when webhook is created
#
# 3. UPI (Test mode)
#    Settings → Payment methods → UPI — enable for test (default in India accounts)
#    Use UPI Intent on mobile/Razorpay Checkout only (not UPI Collect).
#
# 4. Enable live Razorpay API in this app (not mock orders):
#    RAZORPAY_ENABLED=true  + all three keys above set
#
# MOCK MODE (no Razorpay account needed — Swagger/curl webhook simulation):
#    RAZORPAY_ENABLED=false
#    Pay returns order_mock_* ; simulate webhook with any RAZORPAY_WEBHOOK_SECRET you choose
# ─────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENABLED=false

# WhatsApp Business Cloud API webhooks (Meta inbound only)
# Meta App Dashboard → WhatsApp → Configuration → Webhook
# Callback URL: https://<public-host>/api/webhooks/whatsapp
# Verify token: any random string you choose → WHATSAPP_VERIFY_TOKEN
# App secret: Meta App Dashboard → App settings → Basic → App secret → WHATSAPP_APP_SECRET
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Outbound WhatsApp (MSG91 — booking templates + admin manual send)
# Provider: console (local dev) | msg91 (production)
MESSAGING_WHATSAPP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_NAMESPACE=
MSG91_WHATSAPP_API_BASE=https://control.msg91.com
MSG91_WEBHOOK_SECRET=
# Template names as registered in MSG91 dashboard (Meta-approved)
MSG91_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation
MSG91_TEMPLATE_BOOKING_REMINDER=booking_reminder
MSG91_TEMPLATE_BOOKING_CANCELLATION=booking_cancellation
# MSG91 outbound webhook URL: https://<public-host>/api/webhooks/msg91/whatsapp
