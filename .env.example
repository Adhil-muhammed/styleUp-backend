# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# PostgreSQL (Supabase — primary)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.icmshcvapojlqvgpkyat.supabase.co:5432/postgres
POSTGRES_HOST=db.icmshcvapojlqvgpkyat.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres
POSTGRES_SSL=true
POSTGRES_POOL_MAX=10
POSTGRES_POOL_MIN=2
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000

# MongoDB (optional — not connected yet)
# MONGODB_URI=mongodb://localhost:27017/styleup
MONGO_PORT=27017
MONGO_DB=styleup

# Redis (required for OTP auth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — access 15m / refresh 7d (prefer dedicated secrets)
JWT_ACCESS_SECRET=your-jwt-access-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
# Legacy fallback (used if JWT_ACCESS_SECRET / JWT_REFRESH_SECRET unset)
# JWT_SECRET=your-jwt-secret-here

# OTP tuning
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RATE_MAX=3
AUTH_OTP_RATE_WINDOW_SECONDS=60
AUTH_OTP_MAX_VERIFY_ATTEMPTS=5
AUTH_OTP_IP_RATE_MAX=20
AUTH_OTP_IP_RATE_WINDOW_SECONDS=3600
AUTH_OTP_SMS_IP_RATE_MAX=10
AUTH_OTP_SMS_IP_RATE_WINDOW_SECONDS=3600
AUTH_OTP_DEVICE_RATE_MAX=20
AUTH_OTP_DEVICE_RATE_WINDOW_SECONDS=3600

# Session cleanup (revoked / expired user_sessions purge)
AUTH_SESSION_RETENTION_DAYS=7
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
AUTH_SESSION_CLEANUP_ENABLED=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
